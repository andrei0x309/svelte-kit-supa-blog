{
  "name": "svelte-kit-supa-blog",
  "version": "0.3.0",
  "scripts": {
    "dev": "bun run vite dev",
    "build": "bun run vite build",
    "dev-netlify": "netlify dev",
    "cron": "bun run ./src/cli/cron.ts",
    "preview": "vite preview",
    "test": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "lint": "bun x biome lint --write",
    "format": "bun x biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-netlify": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "jodit": "^4.6.2",
    "sass": "^1.92.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "svelte-lightbox": "^1.1.7",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vite-compatible-readable-stream": "^3.6.1",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "@farcaster/frame-sdk": "^0.1.10",
    "@giscus/svelte": "^3.1.0",
    "@supabase/supabase-js": "^2.57.2",
    "highlight.js": "^11.11.1",
    "truncate-html": "^1.2.2"
  },
  "disabledDependencies": {
    "@builder.io/partytown": "^0.10.3",
    "postcss": "^8.5.3",
    "autoprefixer": "^10.4.21",
    "tslib": "^2.8.1",
    "vite-plugin-node-polyfills": "^0.23.0"
  },
  "browser": {
    "stream": false
  },
  "packageManager": "^bun@1.2.1",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#/*": "./src/*"
  }
}
